OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT=20

# Gen AI Keys (add your key here to enable live LLM reasoning logs)
GEMINI_API_KEY=
# Or use OpenAI key as fallback
OPENAI_API_KEY=

# Force offline simulated flight fallback to prevent slow OpenSky API hangs
OPENSKY_FORCE_OFFLINE=true

# Live OpenSky credentials (leave blank to run offline)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
